# Dependencies
node_modules/

# Build output
dist/
out/
build/
release/
*.asar

# Bundled binaries (see bin/README.md) - large, platform-specific, not source
bin/*
!bin/README.md

# Runtime + local state written by the app or the launcher
videos/
.visionance/
*.pid
logs/
*.log
npm-debug.log*
yarn-error.log*

# Environment / secrets
.env
.env.*
!.env.example

# Superseded pre-2.0 mockup, kept locally for reference only
_legacy/

# Test artefacts
tools/smoke-screenshot.png
coverage/

# Render intermediates. Jobs normally work inside the user data folder, but a
# render aimed at the repo would leave these behind.
# Anchored with a leading slash: an unanchored `work/` or `engines/` would also
# match source directories such as src/main/ai/engines/.
*.vspart
/work/
/jobs/

# Downloaded AI engines, models and managed runtimes. These live in the user
# data folder and are hundreds of megabytes; they must never be committed.
/engines/
/models/
/runtimes/
*.ncnn.bin
*.ncnn.param

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
