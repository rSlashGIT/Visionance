{
  "name": "visionance",
  "productName": "Visionance",
  "version": "2.0.0",
  "description": "Real-time GPU video enhancement and upscaling player for local files and online streams.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage deb",
    "verify:core": "node --test tools/verify-core.js",
    "verify:watch": "node --test tools/verify-watch.js",
    "verify:create": "node --test tools/verify-create.js",
    "verify:reframe": "node --test tools/verify-reframe.js",
    "verify:switch": "electron tools/verify-switch.js",
    "verify:gl": "electron tools/verify-electron.js",
    "verify:export": "node tools/verify-export.js",
    "verify:app": "electron tools/smoke.js",
    "verify:ui": "electron tools/verify-ui.js",
    "verify:seek": "electron tools/verify-seek.js",
    "verify:picture": "electron tools/verify-picture.js",
    "verify:create-preview": "electron tools/verify-create-preview.js",
    "verify:chrome": "electron tools/verify-chrome.js",
    "verify:auto": "node --test tools/verify-auto.js",
    "verify:contract": "node --test tools/verify-output-contract.js",
    "verify:auto-ui": "electron tools/verify-auto-ui.js",
    "verify:audio": "electron tools/verify-audio.js",
    "verify:release": "electron tools/verify-release.js",
    "verify": "npm run verify:core && npm run verify:watch && npm run verify:create && npm run verify:auto && npm run verify:framing && npm run verify:contract && npm run verify:mux && npm run verify:temporal && npm run verify:reframe && npm run verify:gl && npm run verify:export && npm run verify:ai && npm run verify:creator && npm run verify:switch && npm run verify:app && npm run verify:ui && npm run verify:seek && npm run verify:picture && npm run verify:create-preview && npm run verify:auto-ui && npm run verify:chrome",
    "launch": "node tools/launcher.js",
    "stop": "node tools/launcher.js --stop",
    "doctor": "node tools/launcher.js --doctor",
    "verify:ai": "node tools/verify-ai.js",
    "verify:ai:core": "node tools/verify-ai.js --core",
    "verify:creator": "node tools/verify-creator.js",
    "verify:mux": "node --test tools/verify-mux.js",
    "verify:temporal": "node --test tools/verify-temporal.js",
    "verify:framing": "node --test tools/verify-framing.js"
  },
  "keywords": [
    "video",
    "upscaling",
    "player",
    "webgl",
    "enhancement",
    "ffmpeg",
    "electron"
  ],
  "author": "Visionance",
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "onnxruntime-node": "^1.27.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.visionance.app",
    "productName": "Visionance",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!_legacy/**/*",
      "!videos/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/DirectML.dll",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/dxcompiler.dll",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/dxil.dll"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/onnxruntime-node/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "ffmpeg-static@5.2.0": true,
    "electron-winstaller": false
  }
}
